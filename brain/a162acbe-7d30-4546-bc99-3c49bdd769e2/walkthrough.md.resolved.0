  /**
   * Check completed video drafts (finished videos)
   * @param {string} accessToken - Bearer token for authentication
   * @param {number} limit - Number of drafts to retrieve (default: 15)
   * @returns {Promise<Object>} List of completed video drafts
   */
  async checkDraft(accessToken, limit = 15) {
