  /**
   * Generate project title from current date/time
   * Format: "Jan 29 - 15:24"
   * @returns {string}
   */
  _generateProjectTitle() {
    const now = /* @__PURE__ */ new Date();
    const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    const month = months[now.getMonth()];
    const day = now.getDate();
    const hours = String(now.getHours()).padStart(2, "0");
    const minutes = String(now.getMinutes()).padStart(2, "0");
    return `${month} ${day} - ${hours}:${minutes}`;
  }
  /**
   * Create a new project in Google Flow
   * @param {string} accessToken - Bearer access token
   * @param {string} [projectTitle] - Title for the project, auto-generated if not provided
   * @param {string} toolName - Tool name, default "PINHOLE"
