   * @param {object} options - Additional options
   * @param {string} options.aspectRatio - '16:9' (landscape) or '9:16' (portrait), default '16:9'
   * @param {Array} options.imageInputs - Optional array of image inputs [{name, imageInputType}]
   * @param {number} options.count - Number of images to generate (default 4)
   * @param {string} options.imageModelName - Model name (default 'GEM_PIX_2')
   * @param {string} options.tool - Tool name (default 'PINHOLE')
   * @returns {Promise<{success: boolean, data?: object, error?: string}>}
   */
  async batchGenerateImages(accessToken, projectId, prompt, recaptchaToken, options = {}) {
    try {
      if (!accessToken) {
        return {
          success: false,
          error: "No access token provided"
        };
      }
      if (!projectId) {
        return {
          success: false,
          error: "No project ID provided"
        };
      }
      if (!prompt) {
        return {
          success: false,
          error: "No prompt provided"
        };
      }
      if (!recaptchaToken) {
        return {
          success: false,
          error: "No recaptcha token provided"
        };
      }
      const {
        aspectRatio = "16:9",
        imageInputs = [],
        count = 4,
        imageModelName = "GEM_PIX_2",
        tool = "PINHOLE"
      } = options;
      const imageAspectRatio = aspectRatio === "9:16" ? "IMAGE_ASPECT_RATIO_PORTRAIT" : "IMAGE_ASPECT_RATIO_LANDSCAPE";
      const sessionId = this._generateSessionId();
      const clientContext = {
        recaptchaContext: {
          token: recaptchaToken,
          applicationType: "RECAPTCHA_APPLICATION_TYPE_WEB"
        },
        sessionId,
        projectId,
        tool
      };
      const requests = [];
      for (let i = 0; i < count; i++) {
        requests.push({
          clientContext,
          seed: this._generateSeed(),
          imageModelName,
          imageAspectRatio,
          prompt,
          imageInputs
        });
      }
      const url = `${this.baseUrl}/projects/${projectId}/flowMedia:batchGenerateImages`;
      const body = {
        clientContext,
        requests
      };
      console.log(`[FlowAPI] Batch generating ${count} images for project ${projectId}`);
      const data = await this._postRequest(url, accessToken, body);
      const images = (data?.media || []).map((media) => ({
        name: media.name,
        workflowId: media.workflowId,
        mediaGenerationId: media.image?.generatedImage?.mediaGenerationId,
        fifeUrl: media.image?.generatedImage?.fifeUrl,
        seed: media.image?.generatedImage?.seed,
        prompt: media.image?.generatedImage?.prompt,
        aspectRatio: media.image?.generatedImage?.aspectRatio,
        width: media.image?.dimensions?.width,
        height: media.image?.dimensions?.height
      }));
      return {
        success: true,
        images,
        data
      };
    } catch (error) {
