  /**
   * Create video generation task
   * @param {string} accessToken - Bearer token for authentication
   * @param {Object} params - Task parameters (prompt, orientation, duration, fileId, styleId, model)
   * @param {string} sentinelToken - Optional Sentinel token (will auto-get from pool if not provided)
   * @returns {Promise<Object>} Task creation response with task_id
   */
  async createTask(accessToken, params, sentinelToken = null) {
    try {
      const {
        prompt,
        orientation,
        duration,
        fileId,
        styleId,
        model
      } = params;
      const n_frames = duration === 10 ? 300 : 450;
      const inpaint_items = fileId ? [{
        kind: "file",
        file_id: fileId
      }] : [];
      let token = sentinelToken;
      if (!token) {
        console.log("[SoraAPI] No sentinel token provided, getting from pool...");
        try {
          token = await this.getSentinelToken("sora_2_create_task");
          if (token) {
            console.log(`[SoraAPI] Got sentinel token: ${token.substring(0, 30)}...`);
          } else {
            console.log("[SoraAPI] Warning: Could not get sentinel token, proceeding without it");
          }
        } catch (tokenError) {
          console.log(`[SoraAPI] Error getting sentinel token: ${tokenError.message}`);
        }
      }
      const body = JSON.stringify({
        kind: "video",
        prompt,
        title: null,
        orientation,
        size: "small",
        n_frames,
        inpaint_items,
        remix_target_id: null,
        metadata: null,
        cameo_ids: null,
        cameo_replacements: null,
        model: model || "sy_8_20251208",
        style_id: styleId || null,
        audio_caption: null,
        audio_transcript: null,
        video_caption: null,
        storyboard_id: null
      });
      const headers = {
        Accept: "*/*",
        "Accept-Language": "en-US,en;q=0.9,vi;q=0.8",
        Authorization: `Bearer ${accessToken}`,
        "Content-Type": "application/json",
        "oai-device-id": this.deviceId,
        "oai-language": "en-US",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/143.0.0.0 Safari/537.36"
      };
      if (token) {
        headers["openai-sentinel-token"] = token;
      }
      console.log(`[SoraAPI] Creating task with prompt: ${prompt.substring(0, 40)}...`);
      const result = await this.request(`${this.baseURL}/backend/nf/create`, {
        method: "POST",
        headers,
        body
      });
      if (result.success) {
        console.log(`[SoraAPI] Task created successfully: ${result.data?.id}`);
        return {
          ...result,
          taskId: result.data?.id,
          priority: result.data?.priority,
          rateLimitReached: result.data?.rate_limit_and_credit_balance?.rate_limit_reached,
          accessResetsInSeconds: result.data?.rate_limit_and_credit_balance?.access_resets_in_seconds,
          creditRemaining: result.data?.rate_limit_and_credit_balance?.credit_remaining,
          estimatedVideosRemaining: result.data?.rate_limit_and_credit_balance?.estimated_num_videos_remaining,
          estimatedPurchasedVideosRemaining: result.data?.rate_limit_and_credit_balance?.estimated_num_purchased_videos_remaining
        };
      }
      console.log(`[SoraAPI] Task creation failed: ${result.status}`);
      return result;
    } catch (error) {
      console.error("[createTask] ERROR:", error);
      return {
        success: false,
        error: error.error || error.message,
        status: error.status || 500
      };
    }
  }
  /**
   * Check all pending/processing tasks for the account
   * @param {string} accessToken - Bearer token for authentication
   * @returns {Promise<Object>} List of pending tasks with status and progress
   */
  async checkTask(accessToken) {
    try {
