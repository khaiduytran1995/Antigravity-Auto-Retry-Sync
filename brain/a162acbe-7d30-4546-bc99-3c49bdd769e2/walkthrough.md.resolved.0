  async batchAsyncGenerateVideoTextInBrowser(page, accessToken, projectId, prompt, recaptchaToken, options = {}) {
    const {
      aspectRatio = "16:9",
      userPaygateTier = "PAYGATE_TIER_TWO",
      tool = "PINHOLE"
    } = options;
    const videoAspectRatio = aspectRatio === "9:16" ? "VIDEO_ASPECT_RATIO_PORTRAIT" : "VIDEO_ASPECT_RATIO_LANDSCAPE";
    const videoModelKey = aspectRatio === "9:16" ? "veo_3_1_t2v_portrait" : "veo_3_1_t2v";
    const accessTokenStr = accessToken.replace(/'/g, "\\'");
    const promptStr = prompt.replace(/'/g, "\\'").replace(/\n/g, "\\n");
    const recaptchaTokenStr = recaptchaToken.replace(/'/g, "\\'");
    const result = await page.evaluate(`
      (async function() {
        try {
          // Generate session/scene IDs
          var sessionId = ';' + Date.now();
          var sceneId = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
            var r = (Math.random() * 16) | 0;
            var v = c === 'x' ? r : (r & 0x3) | 0x8;
            return v.toString(16);
          });
          var seed = Math.floor(Math.random() * 1000000);

          var clientContext = {
            recaptchaContext: {
              token: '${recaptchaTokenStr}',
              applicationType: 'RECAPTCHA_APPLICATION_TYPE_WEB'
            },
            sessionId: sessionId,
            projectId: '${projectId}',
            tool: '${tool}',
            userPaygateTier: '${userPaygateTier}'
          };

          var request = {
            aspectRatio: '${videoAspectRatio}',
            seed: seed,
            textInput: {
              prompt: '${promptStr}'
            },
            videoModelKey: '${videoModelKey}',
            metadata: {
              sceneId: sceneId
            }
          };

          var body = {
            clientContext: clientContext,
            requests: [request]
          };

          var response = await fetch('https://aisandbox-pa.googleapis.com/v1/video:batchAsyncGenerateVideoText', {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json',
              'Authorization': 'Bearer ${accessTokenStr}'
            },
            body: JSON.stringify(body),
            credentials: 'include'
          });

          var data = await response.json();

          if (response.ok) {
            return {
              success: true,
              sceneId: sceneId,
              data: data
            };
          }

          return {
            success: false,
            error: data.error ? data.error.message : 'Video generation failed',
            status: response.status,
            data: data
          };
        } catch (error) {
          return { success: false, error: error.message };
        }
      })()
    `);
    return result;
  }
  /**
   * Generate video from start and/or end images via browser fetch
   * @param {Page} page - Playwright page
   * @param {string} accessToken - Bearer token
   * @param {string} projectId - Project ID
   * @param {string} prompt - Video prompt
   * @param {string} recaptchaToken - Recaptcha token
   * @param {string|null} startImageMediaId - Media ID of start image (optional)
   * @param {string|null} endImageMediaId - Media ID of end image (optional)
   * @param {object} options - Options like aspectRatio, userPaygateTier
   * @returns {Promise<{success: boolean, sceneId?: string, data?: object, error?: string}>}
   */
  async batchAsyncGenerateVideoStartAndEndImageInBrowser(page, accessToken, projectId, prompt, recaptchaToken, startImageMediaId, endImageMediaId, options = {}) {
    const {
      aspectRatio = "16:9",
      userPaygateTier = "PAYGATE_TIER_TWO",
      tool = "PINHOLE"
    } = options;
    const videoAspectRatio = aspectRatio === "9:16" ? "VIDEO_ASPECT_RATIO_PORTRAIT" : "VIDEO_ASPECT_RATIO_LANDSCAPE";
    const videoModelKey = "veo_3_1_i2v_s_fl";
    const accessTokenStr = accessToken.replace(/'/g, "\\'");
    const promptStr = prompt.replace(/'/g, "\\'").replace(/\n/g, "\\n");
    const recaptchaTokenStr = recaptchaToken.replace(/'/g, "\\'");
    const startImageMediaIdStr = startImageMediaId ? startImageMediaId.replace(/'/g, "\\'") : "";
    const endImageMediaIdStr = endImageMediaId ? endImageMediaId.replace(/'/g, "\\'") : "";
    const result = await page.evaluate(`
      (async function() {
        try {
          // Generate session/scene IDs
          var sessionId = ';' + Date.now();
          var sceneId = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
            var r = (Math.random() * 16) | 0;
            var v = c === 'x' ? r : (r & 0x3) | 0x8;
            return v.toString(16);
          });
          var seed = Math.floor(Math.random() * 1000000);

          var clientContext = {
            recaptchaContext: {
              token: '${recaptchaTokenStr}',
              applicationType: 'RECAPTCHA_APPLICATION_TYPE_WEB'
            },
            sessionId: sessionId,
            projectId: '${projectId}',
            tool: '${tool}',
            userPaygateTier: '${userPaygateTier}'
          };

          var request = {
            aspectRatio: '${videoAspectRatio}',
            seed: seed,
            textInput: {
              prompt: '${promptStr}'
            },
            videoModelKey: '${videoModelKey}',
            metadata: {
              sceneId: sceneId
            }
          };

          // Add startImage if provided
          var startMediaId = '${startImageMediaIdStr}';
          if (startMediaId) {
            request.startImage = { mediaId: startMediaId };
          }

          // Add endImage if provided
          var endMediaId = '${endImageMediaIdStr}';
          if (endMediaId) {
            request.endImage = { mediaId: endMediaId };
          }

          var body = {
            clientContext: clientContext,
            requests: [request]
          };

          var response = await fetch('https://aisandbox-pa.googleapis.com/v1/video:batchAsyncGenerateVideoStartAndEndImage', {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json',
              'Authorization': 'Bearer ${accessTokenStr}'
            },
            body: JSON.stringify(body),
            credentials: 'include'
          });

          var data = await response.json();

          if (response.ok) {
            return {
              success: true,
              sceneId: sceneId,
              data: data
            };
          }

          return {
            success: false,
            error: data.error ? data.error.message : 'Video generation failed',
            status: response.status,
            data: data
          };
        } catch (error) {
          return { success: false, error: error.message };
        }
      })()
    `);
    return result;
  }
  /**
   * Generate video in browser - auto-selects method based on images
   * @param {Page} page - Playwright page
   * @param {string} accessToken - Bearer token
   * @param {string} projectId - Project ID
   * @param {string} prompt - Video prompt
   * @param {string} recaptchaToken - Recaptcha token
   * @param {object} options - Options including startImageBase64, endImageBase64, aspectRatio
   * @returns {Promise<{success: boolean, sceneId?: string, data?: object, error?: string}>}
   */
  async generateVideoInBrowser(page, accessToken, projectId, prompt, recaptchaToken, options = {}) {
    const {
      startImageBase64,
      endImageBase64,
      aspectRatio = "16:9",
      userPaygateTier = "PAYGATE_TIER_TWO"
    } = options;
    let startImageMediaId = null;
    let endImageMediaId = null;
    if (startImageBase64) {
      this.log("Uploading start image...");
      const uploadResult = await this.uploadUserImageInBrowser(page, accessToken, startImageBase64, {
        aspectRatio
      });
      if (!uploadResult.success) {
        return {
          success: false,
          error: `Failed to upload start image: ${uploadResult.error}`
        };
      }
      startImageMediaId = uploadResult.mediaId;
      this.log(`Start image uploaded, mediaId: ${startImageMediaId}`);
    }
    if (endImageBase64) {
      this.log("Uploading end image...");
      const uploadResult = await this.uploadUserImageInBrowser(page, accessToken, endImageBase64, {
        aspectRatio
      });
      if (!uploadResult.success) {
        return {
          success: false,
          error: `Failed to upload end image: ${uploadResult.error}`
        };
      }
      endImageMediaId = uploadResult.mediaId;
      this.log(`End image uploaded, mediaId: ${endImageMediaId}`);
    }
    if (startImageMediaId || endImageMediaId) {
      this.log("Generating video with images...");
      return await this.batchAsyncGenerateVideoStartAndEndImageInBrowser(page, accessToken, projectId, prompt, recaptchaToken, startImageMediaId, endImageMediaId, {
        aspectRatio,
        userPaygateTier
      });
    } else {
      this.log("Generating video from text...");
      return await this.batchAsyncGenerateVideoTextInBrowser(page, accessToken, projectId, prompt, recaptchaToken, {
        aspectRatio,
        userPaygateTier
      });
    }
  }
  /**
   * Poll for video completion - checks status until video is ready
   * @param {Page} page - Playwright page
   * @param {string} accessToken - Bearer token
   * @param {string} projectId - Project ID
   * @param {string} sceneId - Scene ID from generation request
   * @param {number} maxAttempts - Maximum poll attempts (default 120 = 10 minutes at 5s interval)
   * @param {number} pollInterval - Interval between polls in ms (default 5000)
   * @returns {Promise<{success: boolean, videos?: string[], error?: string}>}
   */
  async pollVideoCompletion(page, accessToken, projectId, sceneId, maxAttempts = 120, pollInterval = 5e3) {
    const accessTokenStr = accessToken.replace(/'/g, "\\'");
    for (let attempt = 1; attempt <= maxAttempts; attempt++) {
      this.log(`Polling video status (attempt ${attempt}/${maxAttempts})...`);
      try {
        const result = await page.evaluate(`
          (async function() {
            try {
              var response = await fetch('https://aisandbox-pa.googleapis.com/v1/video:getVideoGenerations', {
                method: 'POST',
                headers: {
                  'Accept': 'application/json',
                  'Content-Type': 'application/json',
                  'Authorization': 'Bearer ${accessTokenStr}'
                },
                body: JSON.stringify({
                  projectId: '${projectId}',
                  sceneId: '${sceneId}'
                }),
                credentials: 'include'
              });

              var data = await response.json();

              if (!response.ok) {
                return {
                  success: false,
                  error: data.error ? data.error.message : 'Poll request failed',
                  status: response.status
                };
              }

              // Check if video is ready
              if (data && data.generations && data.generations.length > 0) {
                var allCompleted = data.generations.every(function(gen) {
                  return gen.state === 'COMPLETED' || gen.state === 'FAILED';
                });

                if (allCompleted) {
                  var videos = data.generations
                    .filter(function(gen) { return gen.state === 'COMPLETED' && gen.videoUri; })
                    .map(function(gen) { return gen.videoUri; });

                  var hasFailed = data.generations.some(function(gen) { return gen.state === 'FAILED'; });

                  if (videos.length > 0) {
                    return { success: true, videos: videos, completed: true };
                  } else if (hasFailed) {
                    return { success: false, error: 'Video generation failed', completed: true };
                  }
                }

                // Check for pending/processing state
                var hasProcessing = data.generations.some(function(gen) {
                  return gen.state === 'PENDING' || gen.state === 'PROCESSING' || gen.state === 'QUEUED';
                });

                if (hasProcessing) {
                  return { success: true, completed: false, data: data };
                }
              }

              // No generations yet
              return { success: true, completed: false, data: data };
            } catch (error) {
              return { success: false, error: error.message };
            }
          })()
        `);
        if (!result.success && result.error) {
          this.log(`Poll error: ${result.error}`);
          if (attempt < maxAttempts) {
            await this.sleep(pollInterval);
            continue;
          }
          return {
            success: false,
            error: result.error
          };
        }
        if (result.completed) {
          if (result.videos && result.videos.length > 0) {
            return {
              success: true,
              videos: result.videos
            };
          } else {
            return {
              success: false,
              error: result.error || "No videos generated"
            };
          }
        }
        this.log(`Video still processing...`);
        await this.sleep(pollInterval);
      } catch (error) {
        this.log(`Poll exception: ${error.message}`);
        if (attempt < maxAttempts) {
          await this.sleep(pollInterval);
          continue;
        }
        return {
          success: false,
          error: error.message
        };
      }
    }
    return {
      success: false,
      error: "Video generation timed out"
    };
  }
  /**
   * Emit task update to renderer
   */
  emitTaskUpdate(taskId, status, resultImages = null, error = null) {
    if (this.mainWindow && !this.mainWindow.isDestroyed()) {
      this.mainWindow.webContents.send("flow:taskUpdate", {
        taskId,
        status,
        resultImages,
        error
      });
    }
  }
  /**
   * Emit queue complete to renderer
   */
  emitQueueComplete() {
    if (this.mainWindow && !this.mainWindow.isDestroyed()) {
      this.mainWindow.webContents.send("flow:queueComplete");
    }
  }
  /**
   * Sleep helper
   */
  sleep(ms) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }
}
class SoraQueueWorker {
  /**
   * @param {number} profileId - Profile ID from database
   * @param {Object} callbacks - Callback functions
   */
  constructor(profileId, callbacks = {}) {
    this.profileId = profileId;
    this.callbacks = callbacks;
    this.browser = null;
    this.page = null;
    this.isReady = false;
    this.profile = null;
    this.accessToken = null;
    this.folderName = null;
    this.rawProxy = null;
    const userDataPath = electron.app.getPath("userData");
    const soraToolDir = path.join(userDataPath, ".soratool");
    this.profilesDir = path.join(soraToolDir, "Profile");
    this.profilePath = null;
  }
  log(message, type = "info") {
    console.log(`[SoraQueueWorker ${this.profileId}] ${message}`);
    if (this.callbacks.onLog) {
      this.callbacks.onLog(message, type);
    }
  }
  // findAvailablePort and waitForChromeReady moved to ProfileBrowserManager
  /**
   * Parse proxy string to object
   * Format: protocol://ip:port or protocol://ip:port:user:pass
   */
  parseProxy(proxyStr) {
    if (!proxyStr || !proxyStr.trim()) return null;
    const match = proxyStr.trim().match(/^(https?|socks5):\/\/([^:]+):(\d+)(?::([^:]+):(.+))?$/);
    if (!match) return null;
    const [, protocol, ip, port, user, pass] = match;
    return {
      protocol,
      ip,
      port: parseInt(port),
      user,
      pass
    };
  }
  /**
   * Get IP info from ip-api.com (with or without proxy)
   */
  async getIPInfo() {
    const axios2 = (await import("axios")).default;
    try {
      let config = {
        timeout: 1e4
      };
      if (this.rawProxy && this.rawProxy.trim()) {
        const proxy = this.parseProxy(this.rawProxy);
        if (proxy) {
          this.log(`Checking IP via proxy: ${proxy.protocol}://${proxy.ip}:${proxy.port}`);
          if (proxy.protocol === "socks5") {
            const {
              SocksProxyAgent
            } = await import("socks-proxy-agent");
            const proxyUrl = proxy.user && proxy.pass ? `socks5://${proxy.user}:${proxy.pass}@${proxy.ip}:${proxy.port}` : `socks5://${proxy.ip}:${proxy.port}`;
            config.httpsAgent = new SocksProxyAgent(proxyUrl);
            config.httpAgent = new SocksProxyAgent(proxyUrl);
          } else {
            const {
              HttpsProxyAgent
            } = await import("https-proxy-agent");
            const proxyUrl = proxy.user && proxy.pass ? `http://${proxy.user}:${proxy.pass}@${proxy.ip}:${proxy.port}` : `http://${proxy.ip}:${proxy.port}`;
            config.httpsAgent = new HttpsProxyAgent(proxyUrl);
            config.httpAgent = new HttpsProxyAgent(proxyUrl);
          }
