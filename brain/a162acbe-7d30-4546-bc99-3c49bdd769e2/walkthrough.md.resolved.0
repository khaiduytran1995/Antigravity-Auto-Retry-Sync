          this.log(`API Response Data: ${JSON.stringify(generateResult.data, null, 2)}`, profile.id);
        }
        throw new Error(`Video generation failed: ${generateResult.error}`);
      }
      const sceneId = generateResult.sceneId;
      this.log(`Video generation started, sceneId: ${sceneId}`, profile.id);
      this.log(`Waiting for video to complete...`, profile.id);
      const pollResult = await this.pollVideoCompletion(page, accessToken, projectId, sceneId);
      if (!pollResult.success) {
        throw new Error(`Video polling failed: ${pollResult.error}`);
      }
      const resultVideos = pollResult.videos || [];
      this.log(`Video completed, got ${resultVideos.length} video(s)`, profile.id);
      this.emitTaskUpdate(task.id, "completed", resultVideos);
    } catch (error) {
      this.log(`Video task failed: ${error.message}`, profile.id);
      this.emitTaskUpdate(task.id, "failed", null, error.message);
    }
  }
  /**
   * Create project via browser fetch
   */
  async createProjectInBrowser(page, accessToken) {
    const projectTitle = `Project_${Date.now()}`;
    const accessTokenStr = accessToken.replace(/'/g, "\\'");
    const result = await page.evaluate(`
      (async function() {
        try {
          var response = await fetch('https://labs.google/fx/api/trpc/project.createProject', {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json',
              'Authorization': 'Bearer ${accessTokenStr}'
            },
            body: JSON.stringify({
              json: {
                projectTitle: '${projectTitle}',
                toolName: 'PINHOLE'
              }
            }),
            credentials: 'include'
          });

          var data = await response.json();

          if (response.ok && data && data.result && data.result.data && data.result.data.json) {
            var jsonResult = data.result.data.json.result;
            return {
              success: true,
              projectId: jsonResult ? jsonResult.projectId : null,
              data: data
            };
          }

          return {
            success: false,
            error: 'Invalid response',
            status: response.status,
            data: data
          };
        } catch (error) {
          return { success: false, error: error.message };
        }
      })()
    `);
    return result;
  }
  /**
   * Batch generate images via browser fetch
   */
  async batchGenerateImagesInBrowser(page, accessToken, projectId, prompt, recaptchaToken, options = {}) {
    const {
      aspectRatio = "16:9",
      imageModelName = "GEM_PIX_2",
      count = 1
    } = options;
    const imageAspectRatio = aspectRatio === "9:16" ? "IMAGE_ASPECT_RATIO_PORTRAIT" : "IMAGE_ASPECT_RATIO_LANDSCAPE";
    const accessTokenStr = accessToken.replace(/'/g, "\\'");
    const promptStr = prompt.replace(/'/g, "\\'").replace(/\n/g, "\\n");
    const recaptchaTokenStr = recaptchaToken.replace(/'/g, "\\'");
    const result = await page.evaluate(`
      (async function() {
        try {
          // Generate session ID
          var sessionId = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
            var r = (Math.random() * 16) | 0;
            var v = c === 'x' ? r : (r & 0x3) | 0x8;
            return v.toString(16);
          });

          // Build client context
          var clientContext = {
            recaptchaContext: {
              token: '${recaptchaTokenStr}',
              applicationType: 'RECAPTCHA_APPLICATION_TYPE_WEB'
            },
            sessionId: sessionId,
            projectId: '${projectId}',
            tool: 'PINHOLE'
          };

          // Build requests array
          var requests = [];
          for (var i = 0; i < ${count}; i++) {
            requests.push({
              clientContext: clientContext,
              seed: Math.floor(Math.random() * 2147483647),
              imageModelName: '${imageModelName}',
              imageAspectRatio: '${imageAspectRatio}',
              prompt: '${promptStr}',
              imageInputs: []
            });
          }

          var body = {
            clientContext: clientContext,
            requests: requests
          };

          var response = await fetch('https://aisandbox-pa.googleapis.com/v1/projects/${projectId}/flowMedia:batchGenerateImages', {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json',
              'Authorization': 'Bearer ${accessTokenStr}'
            },
            body: JSON.stringify(body),
            credentials: 'include'
          });

          var data = await response.json();

          if (response.ok && data && data.media) {
            var images = data.media.map(function(media) {
              if (media.image && media.image.generatedImage && media.image.generatedImage.fifeUrl) {
                return media.image.generatedImage.fifeUrl;
              }
              return null;
            }).filter(function(url) { return url !== null; });

            return {
              success: true,
              images: images,
              data: data
            };
          }

          return {
            success: false,
            error: data.error ? data.error.message : 'Image generation failed',
            status: response.status,
            data: data
          };
        } catch (error) {
          return { success: false, error: error.message };
        }
      })()
    `);
    return result;
  }
  /**
   * Get recaptcha token by executing grecaptcha in the browser
   * @param {Page} page - Playwright page
   * @param {string} action - Action type: 'IMAGE_GENERATION' or 'VIDEO_GENERATION'
   */
  async getRecaptchaToken(page, action = "IMAGE_GENERATION") {
    try {
      const maxWait = 1e4;
      const pollInterval = 500;
      const startTime = Date.now();
      while (Date.now() - startTime < maxWait) {
        const isReady = await page.evaluate(`
          (function() {
            return window.grecaptcha && window.grecaptcha.enterprise;
          })()
        `);
        if (isReady) {
          break;
        }
        await page.waitForTimeout(pollInterval);
      }
      const token = await page.evaluate(`
        (async function() {
          return await window.grecaptcha.enterprise.execute(
            '6LdsFiUsAAAAAIjVDZcuLhaHiDn5nnHVXVRQGeMV',
            { action: '${action}' }
          );
        })()
      `);
      return token;
    } catch (error) {
      this.log(`Failed to get recaptcha token: ${error.message}`);
      return null;
    }
  }
  /**
   * Upload user image via browser fetch
   * @param {Page} page - Playwright page
   * @param {string} accessToken - Bearer token
   * @param {string} imageBase64 - Base64 encoded image data (without data:image prefix)
   * @param {object} options - Options like aspectRatio, mimeType
   * @returns {Promise<{success: boolean, mediaId?: string, error?: string}>}
   */
  async uploadUserImageInBrowser(page, accessToken, imageBase64, options = {}) {
    const {
      aspectRatio = "16:9",
      mimeType = "image/jpeg"
    } = options;
    const imageAspectRatio = aspectRatio === "9:16" ? "IMAGE_ASPECT_RATIO_PORTRAIT" : "IMAGE_ASPECT_RATIO_LANDSCAPE";
    const accessTokenStr = accessToken.replace(/'/g, "\\'");
    const imageBase64Str = imageBase64.replace(/'/g, "\\'");
    const result = await page.evaluate(`
      (async function() {
        try {
          // Generate session ID
          var sessionId = ';' + Date.now();

          var clientContext = {
            sessionId: sessionId,
            tool: 'ASSET_MANAGER'
          };

          var requestBody = {
            clientContext: clientContext,
            imageInput: {
              rawImageBytes: '${imageBase64Str}'
            },
            aspectRatio: '${imageAspectRatio}',
            isUserUploaded: true,
            mimeType: '${mimeType}'
          };

          var response = await fetch('https://aisandbox-pa.googleapis.com/v1:uploadUserImage', {
            method: 'POST',
            headers: {
              'Accept': '*/*',
              'Content-Type': 'text/plain;charset=UTF-8',
              'Authorization': 'Bearer ${accessTokenStr}'
            },
            body: JSON.stringify(requestBody),
            credentials: 'include'
          });

          var data = await response.json();

          if (response.ok && data && data.mediaId) {
            return {
              success: true,
              mediaId: data.mediaId,
              data: data
            };
          }

          return {
            success: false,
            error: data.error ? data.error.message : 'Upload failed',
            status: response.status,
            data: data
          };
        } catch (error) {
          return { success: false, error: error.message };
        }
      })()
    `);
    return result;
  }
  /**
