        }
      });
      if (result.success && Array.isArray(result.data)) {
        return {
          success: true,
          tasks: result.data,
          count: result.data.length,
          status: result.status
        };
      }
      return result;
    } catch (error) {
      console.error("checkTask error:", error);
      return {
