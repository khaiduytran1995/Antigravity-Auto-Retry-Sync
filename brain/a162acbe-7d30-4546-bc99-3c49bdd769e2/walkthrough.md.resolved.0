   */
  async createProject(accessToken, projectTitle = null, toolName = "PINHOLE") {
    try {
      if (!accessToken) {
        return {
          success: false,
          error: "No access token provided"
        };
      }
      const title = projectTitle || this._generateProjectTitle();
      const url = "https://labs.google/fx/api/trpc/project.createProject";
      const body = {
        json: {
          projectTitle: title,
          toolName
        }
      };
      console.log(`[FlowAPI] Creating project: ${title}`);
      const data = await this._postRequest(url, accessToken, body);
      const jsonResult = data?.result?.data?.json?.result;
      return {
        success: true,
        projectId: jsonResult?.projectId || null,
        projectTitle: jsonResult?.projectInfo?.projectTitle || title,
        data
      };
    } catch (error) {
      console.error("[FlowAPI] createProject error:", error.message);
      return {
        success: false,
        error: error.message
      };
    }
