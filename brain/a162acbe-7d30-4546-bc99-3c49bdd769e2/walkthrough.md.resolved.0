--${boundary}\r
Content-Disposition: form-data; name="use_case"\r
\r
inpaint_safe\r
--${boundary}--\r
`);
      const body = Buffer.concat([header, fileBuffer, footer]);
      const requestOptions = {
        url: `${this.baseURL}/backend/project_y/file/upload`,
        method: "POST"
      };
      const request = electron.net.request(requestOptions);
      request.setHeader("Accept", "*/*");
      request.setHeader("Accept-Language", "en-US,en;q=0.9,vi;q=0.8");
      request.setHeader("Authorization", `Bearer ${accessToken}`);
      request.setHeader("Content-Type", `multipart/form-data; boundary=${boundary}`);
      request.setHeader("oai-device-id", this.deviceId);
      request.setHeader("oai-language", "en-US");
      request.setHeader("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/143.0.0.0 Safari/537.36");
      let responseData = "";
