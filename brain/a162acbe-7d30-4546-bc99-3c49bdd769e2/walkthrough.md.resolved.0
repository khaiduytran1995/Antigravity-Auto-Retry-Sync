      });
      if (result.success && result.data) {
        return {
          success: true,
          user: result.data.user,
          userId: result.data.user?.id,
          userName: result.data.user?.name,
          username: result.data.user?.username,
          email: result.data.user?.email,
          isAdmin: result.data.user?.is_admin,
          settings: result.data.user?.settings,
          onboarding: result.data.onboarding,
          countrySupported: result.data.country_supported,
          isCountrySupported: result.data.country_supported?.is_supported,
          country: result.data.country_supported?.country,
          inNf: result.data.in_nf,
          status: result.status,
          data: result.data
        };
      }
      return result;
    } catch (error) {
      console.error("checkAuth error:", error);
      return {
        success: false,
        error: error.error || error.message,
        status: error.status || 500
      };
    }
