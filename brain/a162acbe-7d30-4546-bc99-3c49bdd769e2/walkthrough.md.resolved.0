  /**
   * Upload image file to Sora backend
   * @param {string} accessToken - Bearer token for authentication
   * @param {Buffer} fileBuffer - Image file buffer
   * @param {string} filename - Original filename
   * @param {string} mimeType - MIME type (e.g., 'image/jpeg', 'image/png')
   * @returns {Promise<Object>} Upload response with file_id and url
   */
  async uploadImage(accessToken, fileBuffer, filename, mimeType = "image/jpeg") {
    return new Promise((resolve, reject) => {
      const boundary = `----WebKitFormBoundary${Math.random().toString(36).substring(2)}`;
      const parts = [];
      parts.push(`--${boundary}\r
`);
      parts.push(`Content-Disposition: form-data; name="file"; filename="${filename}"\r
`);
      parts.push(`Content-Type: ${mimeType}\r
\r
`);
      const header = Buffer.from(parts.join(""));
      const footer = Buffer.from(`\r
--${boundary}\r
Content-Disposition: form-data; name="use_case"\r
\r
inpaint_safe\r
--${boundary}--\r
`);
      const body = Buffer.concat([header, fileBuffer, footer]);
      const requestOptions = {
        url: `${this.baseURL}/backend/project_y/file/upload`,
        method: "POST"
      };
      const request = electron.net.request(requestOptions);
      request.setHeader("Accept", "*/*");
      request.setHeader("Accept-Language", "en-US,en;q=0.9,vi;q=0.8");
      request.setHeader("Authorization", `Bearer ${accessToken}`);
      request.setHeader("Content-Type", `multipart/form-data; boundary=${boundary}`);
      request.setHeader("oai-device-id", this.deviceId);
      request.setHeader("oai-language", "en-US");
      request.setHeader("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/143.0.0.0 Safari/537.36");
      let responseData = "";
      let statusCode = 200;
      request.on("response", (response) => {
        statusCode = response.statusCode;
        response.on("data", (chunk) => {
          responseData += chunk.toString();
        });
        response.on("end", () => {
          try {
            const data = JSON.parse(responseData);
            resolve({
              success: statusCode >= 200 && statusCode < 300,
              data,
              status: statusCode,
              // Extract key fields for convenience
              fileId: data.file_id,
              assetPointer: data.asset_pointer,
              url: data.url
            });
          } catch (error) {
            resolve({
              success: statusCode >= 200 && statusCode < 300,
              data: responseData,
              status: statusCode
            });
          }
        });
      });
      request.on("error", (error) => {
        console.error("Upload image error:", error);
        reject({
          success: false,
          error: error.message,
          status: 500
        });
      });
      request.write(body);
      request.end();
    });
  }
  /**
   * Remove watermark from video using axios
   * @param {string} videoPermalink - Sora video URL/permalink
   * @returns {Promise<Object>} Response with watermark-free video URL
   */
  async removeWatermark(videoPermalink) {
    try {
      console.log("[removeWatermark] Calling API with URL:", videoPermalink);
      const response = await axios.post("https://api.sorafy.app/process", {
        sora_url: videoPermalink
      }, {
        headers: {
          "Content-Type": "application/json"
        },
        timeout: 3e4
      });
      console.log("[removeWatermark] Response:", response.data);
      const data = response.data;
      if (data.ok && data.download_url) {
        return {
          success: true,
          data: {
            download_url: data.download_url,
            ok: data.ok
          },
          status: response.status
        };
      } else {
        return {
          success: false,
          error: data.error || "No download URL returned",
          status: response.status
        };
      }
    } catch (error) {
      console.error("[removeWatermark] Error:", error.message);
      return {
        success: false,
        error: error.response?.data?.error || error.message,
        status: error.response?.status || 500
      };
    }
  }
  // Stub methods for compatibility with index.js IPC handlers
  // These are disabled - use TokenWorker instead
  async initialize() {
    console.log("SoraAPI: Only removeWatermark is enabled. Use TokenWorker for other APIs.");
    return {
      success: true
    };
  }
  setTokenWorker(worker) {
  }
  destroy() {
  }
}
class FlowAPI {
  constructor() {
    this.baseUrl = "https://aisandbox-pa.googleapis.com/v1";
    this.userAgent = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/144.0.0.0 Safari/537.36";
  }
  /**
   * Make a GET request using Electron's net module
   * @param {string} url - Full URL to request
   * @param {string} accessToken - Bearer token for authorization
   * @returns {Promise<object>} - Response data
   */
  _request(url, accessToken) {
    return new Promise((resolve, reject) => {
      const request = electron.net.request({
        method: "GET",
        url
      });
      request.setHeader("Authorization", `Bearer ${accessToken}`);
      request.setHeader("User-Agent", this.userAgent);
      request.setHeader("Accept", "application/json");
      let responseData = "";
      request.on("response", (response) => {
        response.on("data", (chunk) => {
          responseData += chunk.toString();
        });
        response.on("end", () => {
          try {
            if (response.statusCode >= 200 && response.statusCode < 300) {
              const data = JSON.parse(responseData);
              resolve(data);
            } else {
              reject(new Error(`HTTP ${response.statusCode}: ${responseData}`));
            }
          } catch (e) {
            reject(new Error(`Failed to parse response: ${e.message}`));
          }
        });
      });
      request.on("error", (error) => {
        reject(error);
      });
      request.end();
    });
  }
  /**
   * Get credits for a Google Flow account
   * @param {string} accessToken - Bearer access token
   * @returns {Promise<{success: boolean, credits?: number, userPaygateTier?: string, sku?: string, error?: string}>}
   */
  async getCredits(accessToken) {
    try {
      if (!accessToken) {
        return {
          success: false,
          error: "No access token provided"
        };
      }
      const url = `${this.baseUrl}/credits`;
      const data = await this._request(url, accessToken);
      return {
        success: true,
        credits: data.credits || 0,
        userPaygateTier: data.userPaygateTier || "",
        sku: data.sku || ""
      };
    } catch (error) {
      console.error("[FlowAPI] getCredits error:", error.message);
      return {
        success: false,
        error: error.message
      };
    }
  }
  /**
   * Make a POST request using Electron's net module
