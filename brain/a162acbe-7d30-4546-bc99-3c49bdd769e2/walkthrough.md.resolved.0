    try {
      const allProfiles = await getProfilesByType(2);
      const selectedProfiles = allProfiles.filter((p) => profileIds.includes(p.id));
      if (selectedProfiles.length === 0) {
        throw new Error("No valid profiles selected");
      }
      const win = electron.BrowserWindow.getAllWindows()[0];
      if (!flowQueueWorker) {
        flowQueueWorker = new FlowQueueWorker(win);
      }
      flowQueueWorker.mainWindow = win;
      await flowQueueWorker.startImageQueue(profileIds, tasks, selectedProfiles);
      return {
        success: true
      };
    } catch (error) {
      console.error("[Flow] startImageQueue error:", error);
      return {
        success: false,
        error: error.message
      };
    }
  });
  electron.ipcMain.handle("flow:stopQueue", async () => {
    try {
      if (flowQueueWorker) {
        await flowQueueWorker.stopQueue();
      }
      return {
        success: true
      };
    } catch (error) {
      console.error("[Flow] stopQueue error:", error);
      return {
        success: false,
        error: error.message
      };
    }
  });
  electron.ipcMain.on("ping", () => console.log("pong"));
  createWindow();
  electron.app.on("activate", function() {
    if (electron.BrowserWindow.getAllWindows().length === 0) createWindow();
  });
});
electron.app.on("window-all-closed", () => {
  if (process.platform !== "darwin") {
    electron.app.quit();
  }
});
electron.app.on("before-quit", () => {
  if (soraAPI) {
    soraAPI.destroy();
  }
  closeDatabase();
});
```

