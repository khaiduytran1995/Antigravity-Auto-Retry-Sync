  /**
   * Publish draft videos to the feed
   * @param {string} accessToken - Bearer token for authentication
   * @param {Array<string>} generationIds - Array of generation IDs to publish
   * @param {string} postText - Text/caption for the post
   * @param {string} sentinelToken - Optional Sentinel token (will auto-get from pool if not provided)
   * @returns {Promise<Object>} Post creation response
   */
  async postDraft(accessToken, generationIds, postText, sentinelToken = null) {
    try {
      const attachments_to_create = generationIds.map((id) => ({
        generation_id: id,
        kind: "sora"
      }));
      const truncatedPostText = postText && postText.length > 50 ? postText.substring(0, 50) : postText;
      let token = sentinelToken;
      if (!token) {
        console.log("[SoraAPI] No sentinel token for postDraft, getting from pool...");
        try {
          token = await this.getSentinelToken("sora_2_create_post");
          if (token) {
            console.log(`[SoraAPI] Got sentinel token for post: ${token.substring(0, 30)}...`);
          } else {
            console.log("[SoraAPI] Warning: Could not get sentinel token for post");
          }
        } catch (tokenError) {
          console.log(`[SoraAPI] Error getting sentinel token for post: ${tokenError.message}`);
        }
      }
      const body = JSON.stringify({
        attachments_to_create,
        post_text: truncatedPostText
      });
      const headers = {
        Accept: "*/*",
        "Accept-Language": "en-US,en;q=0.9,vi;q=0.8",
        Authorization: `Bearer ${accessToken}`,
        "Content-Type": "application/json",
        "oai-device-id": this.deviceId,
        "oai-language": "en-US",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/143.0.0.0 Safari/537.36"
      };
      if (token) {
        headers["openai-sentinel-token"] = token;
      }
      console.log(`[SoraAPI] Posting draft with ${generationIds.length} videos...`);
      const result = await this.request(`${this.baseURL}/backend/project_y/post`, {
        method: "POST",
        headers,
        body
      });
      if (result.success) {
        console.log("[SoraAPI] Draft posted successfully!");
      }
      return result;
    } catch (error) {
      console.error("postDraft error:", error);
      return {
        success: false,
        error: error.error || error.message,
        status: error.status || 500
      };
    }
  }
  /**
   * Delete a draft video
   * @param {string} accessToken - Bearer token for authentication
   * @param {string} draftId - Draft ID to delete
   * @returns {Promise<Object>} Delete response
   */
  async deleteDraft(accessToken, draftId) {
    try {
      if (!draftId) throw new Error("Missing draftId");
      const result = await this.request(`${this.baseURL}/backend/project_y/profile/drafts/${draftId}`, {
        method: "DELETE",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "oai-device-id": this.deviceId,
          "oai-language": "en-US"
