  /**
   * Verify SMS code after sending SMS
   * @param {string} accessToken - Bearer token for authentication
   * @param {string} phoneNumber - Phone number with country code
   * @param {string} verificationCode - 6-digit verification code received via SMS
   * @returns {Promise<Object>} Verification response
   */
  async vericodeSMS(accessToken, phoneNumber, verificationCode) {
    try {
      if (!phoneNumber) throw new Error("Missing phoneNumber");
